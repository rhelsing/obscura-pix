<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group reserved for the app and its Notification Service Extension.
	     See ios/Obscura/SharedContainer.swift.
	     This identifier must also be registered against the team in the Apple Developer
	     portal — an unregistered group produces a nil container at runtime, not a build
	     error, so SharedContainer.isAvailable is what actually proves it works.

	     Deliberately NOT adding a keychain-access-groups entry: on iOS an App Group id is
	     already usable as a keychain access group, and adding that entitlement would make
	     its first entry the default group for items that do not name one. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.barrelmaker.obscura</string>
	</array>
</dict>
</plist>
