{
  "version": 1,
  "kind": "merge",
  "description": "Application merge conformance. Applies incoming entries and pins the resolved state. Cases with multiple applyOrders assert convergence: the same entries applied in different arrival orders must resolve to identical state. The future-timestamp clamp is not vector-tested because it is wall-clock-relative; per-kit tests cover it.",
  "cases": [
    {
      "name": "GSet union merges distinct entries, order-independent",
      "sync": "gset",
      "applyOrders": ["forward", "reverse"],
      "ops": [
        { "id": "x", "ts": 1, "authorDeviceId": "devA", "data": { "v": "x" } },
        { "id": "y", "ts": 2, "authorDeviceId": "devB", "data": { "v": "y" } },
        { "id": "z", "ts": 3, "authorDeviceId": "devA", "data": { "v": "z" } }
      ],
      "expect": {
        "entries": [
          { "id": "x", "data": { "v": "x" } },
          { "id": "y", "data": { "v": "y" } },
          { "id": "z", "data": { "v": "z" } }
        ]
      }
    },
    {
      "name": "GSet is idempotent: a duplicate id does not change state",
      "sync": "gset",
      "applyOrders": ["forward"],
      "ops": [
        { "id": "x", "ts": 1, "authorDeviceId": "devA", "data": { "v": "x" } },
        { "id": "x", "ts": 1, "authorDeviceId": "devA", "data": { "v": "x" } }
      ],
      "expect": {
        "entries": [
          { "id": "x", "data": { "v": "x" } }
        ]
      }
    },
    {
      "name": "LWW keeps the higher timestamp, order-independent",
      "sync": "lww",
      "applyOrders": ["forward", "reverse"],
      "ops": [
        { "id": "settings", "ts": 1, "authorDeviceId": "devA", "data": { "theme": "dark" } },
        { "id": "settings", "ts": 2, "authorDeviceId": "devB", "data": { "theme": "light" } }
      ],
      "expect": {
        "entries": [
          { "id": "settings", "authorDeviceId": "devB", "data": { "theme": "light" } }
        ]
      }
    },
    {
      "name": "LWW equal-timestamp conflict resolves deterministically by authorDeviceId (higher wins), order-independent",
      "sync": "lww",
      "applyOrders": ["forward", "reverse"],
      "ops": [
        { "id": "settings", "ts": 5, "authorDeviceId": "devA", "data": { "theme": "dark" } },
        { "id": "settings", "ts": 5, "authorDeviceId": "devB", "data": { "theme": "light" } }
      ],
      "expect": {
        "entries": [
          { "id": "settings", "authorDeviceId": "devB", "data": { "theme": "light" } }
        ]
      }
    }
  ]
}
